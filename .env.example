# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://aletheia:aletheia@localhost:5432/aletheia

# Docker Compose knobs (safe defaults, no secrets)
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=aletheia
POSTGRES_DB=aletheia
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Groq fact extraction (optional): no key means the facts endpoints
# report unavailable; ingestion never requires it. Never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Groq request management (free-tier aware): request-size limit, token
# budget, RPM spacing, and retry/backoff bounds. No secrets here.
GROQ_MAX_INPUT_TOKENS_PER_REQUEST=2000
GROQ_EXPECTED_OUTPUT_TOKENS=1000
GROQ_TPM_TARGET=6500
GROQ_MIN_REQUEST_INTERVAL_S=2.5
GROQ_MAX_RETRIES=5
GROQ_BACKOFF_BASE_S=1.0
GROQ_BACKOFF_MAX_S=60.0

# Local OCR fallback (PaddleOCR): no credentials or cloud calls needed.
# Models are pre-warmed in the Docker image; unit tests never touch them.
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_LANGUAGE=en
OCR_ALLOW_MODEL_DOWNLOAD=false

# Starter datasets live outside the repo; configurable path only
DATASET_DIR=../starter-datasets
