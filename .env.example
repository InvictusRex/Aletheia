# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://aletheia:aletheia@localhost:5432/aletheia

# Docker Compose knobs (safe defaults, no secrets)
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=aletheia
POSTGRES_DB=aletheia
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Groq fact extraction (optional): no key means the facts endpoints
# report unavailable; ingestion never requires it. Never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Groq request management (free-tier aware): RPM spacing and
# retry/backoff bounds. No secrets here.
GROQ_MIN_REQUEST_INTERVAL_S=2.5
GROQ_MAX_RETRIES=5
GROQ_BACKOFF_BASE_S=1.0
GROQ_BACKOFF_MAX_S=60.0

# Local Ollama inference (alternative provider, no key, no cloud calls).
# The host owns the model; the backend only talks HTTP to OLLAMA_BASE_URL.
# OLLAMA_THINK is optional (true/false); when unset it is omitted and the
# model default applies. Live-model verification of `think` is pending.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b
#OLLAMA_THINK=
OLLAMA_KEEP_ALIVE=-1
OLLAMA_TIMEOUT_S=120
OLLAMA_MAX_RETRIES=2
OLLAMA_BACKOFF_BASE_S=1.0
OLLAMA_BACKOFF_MAX_S=30.0

# Internal ML service (PaddleOCR + MiniLM over HTTP, Compose network).
ML_SERVICE_URL=http://ml:8001

# Local OCR fallback (PaddleOCR): no credentials or cloud calls needed.
# Models are pre-warmed in the Docker image; unit tests never touch them.
OCR_ENABLED=true
OCR_PROVIDER=paddleocr
OCR_LANGUAGE=en
OCR_ALLOW_MODEL_DOWNLOAD=false

# Starter datasets live outside the repo; configurable path only
DATASET_DIR=../starter-datasets
